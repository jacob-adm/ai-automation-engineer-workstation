{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.secrets/**)",
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(**/.dotfiles.local)",
      "Read(./.worktrees/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.git/**)",
      "Read(**/node_modules/**)",
      "Read(**/.pueue/**)"
    ],
    "allow": [
      "Edit(**/*.md)",
      "Edit(**/*.txt)",
      "Edit(**/tests/**)",
      "Edit(**/test_*.py)"
    ]
  }
}
