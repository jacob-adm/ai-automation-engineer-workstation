[init]
    defaultBranch = main

[core]
    editor = vim
    excludesfile = ~/.gitignore_global
    autocrlf = input
    quotepath = false

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[diff]
    colorMoved = default
    renames = copies

[merge]
    conflictstyle = diff3

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[alias]
    st = status -sb
    status-all = status
    co = checkout
    br = branch -v
    ci = commit
    cm = commit -m
    ca = commit --amend
    last = log -1 HEAD
    diffc = diff --cached
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
    unstage = reset HEAD --
    discard = checkout --
    aliases = config --get-regexp alias

# Include local user credentials and settings if present
[include]
    path = ~/.gitconfig.local
