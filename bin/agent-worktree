#!/usr/bin/env bash
# bin/agent-worktree: Git worktree manager for concurrent AI agent harnesses

set -euo pipefail

BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
CYAN="\033[0;36m"
RESET="\033[0m"

log_info()    { echo -e "${CYAN}[INFO]${RESET} $*"; }
log_success() { echo -e "${GREEN}[OK]${RESET} $*"; }
log_warn()    { echo -e "${YELLOW}[WARN]${RESET} $*"; }
log_error()   { echo -e "${RED}[ERROR]${RESET} $*"; }

usage() {
    cat << EOF
${BOLD}agent-worktree${RESET} - Manage isolated git worktrees for concurrent AI agent workflows

${BOLD}Usage:${RESET}
  agent-worktree new <task-name> [base-branch]   Create an isolated worktree and branch
  agent-worktree list                           List all active agent worktrees
  agent-worktree merge <task-name>              Merge agent branch into current branch
  agent-worktree remove <task-name> [--force]   Remove an agent worktree
  agent-worktree clean                          Prune stale worktree metadata

${BOLD}Examples:${RESET}
  agent-worktree new refactor-auth
  agent-worktree merge refactor-auth
  agent-worktree remove refactor-auth
EOF
}

check_git_repo() {
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        log_error "Not inside a git repository."
        exit 1
    fi
}

cmd_new() {
    local task_name="${1:-}"
    local base_branch="${2:-HEAD}"

    if [ -z "$task_name" ]; then
        log_error "Task name required. Usage: agent-worktree new <task-name> [base-branch]"
        exit 1
    fi

    check_git_repo
    local repo_root
    repo_root="$(git rev-parse --show-toplevel)"
    local worktree_dir="${repo_root}/.worktrees/${task_name}"
    local branch_name="agent/${task_name}"

    if [ -d "$worktree_dir" ]; then
        log_error "Worktree directory already exists: $worktree_dir"
        exit 1
    fi

    # Ensure .worktrees is gitignored in repo root
    if [ -f "${repo_root}/.gitignore" ]; then
        if ! grep -q "^\.worktrees" "${repo_root}/.gitignore"; then
            echo -e "\n.worktrees/" >> "${repo_root}/.gitignore"
            log_info "Added .worktrees/ to ${repo_root}/.gitignore"
        fi
    fi

    mkdir -p "$(dirname "$worktree_dir")"

    log_info "Creating worktree at $worktree_dir on branch $branch_name (from $base_branch)..."
    git worktree add -b "$branch_name" "$worktree_dir" "$base_branch"

    # Copy project local secrets if present, keeping secure permissions
    if [ -f "${repo_root}/.envrc" ]; then
        cp "${repo_root}/.envrc" "${worktree_dir}/.envrc" 2>/dev/null || true
    fi

    log_success "Worktree created successfully!"
    echo ""
    echo -e "To enter your isolated agent environment:"
    echo -e "  ${BOLD}cd ${worktree_dir}${RESET}"
    echo ""
    echo -e "When finished, merge back into your main branch with:"
    echo -e "  ${BOLD}agent-worktree merge ${task_name}${RESET}"
}

cmd_list() {
    check_git_repo
    echo -e "${BOLD}${CYAN}=== Active Git Worktrees ===${RESET}"
    git worktree list
}

cmd_merge() {
    local task_name="${1:-}"
    if [ -z "$task_name" ]; then
        log_error "Task name required. Usage: agent-worktree merge <task-name>"
        exit 1
    fi

    check_git_repo
    local branch_name="agent/${task_name}"
    local repo_root
    repo_root="$(git rev-parse --show-toplevel)"
    local worktree_dir="${repo_root}/.worktrees/${task_name}"

    log_info "Merging branch '$branch_name' into current branch..."
    git merge --no-ff "$branch_name" -m "merge: agent task '$task_name'"

    log_success "Merged successfully!"

    if [ -d "$worktree_dir" ]; then
        log_info "Removing worktree directory: $worktree_dir"
        git worktree remove "$worktree_dir"
        git branch -d "$branch_name" 2>/dev/null || log_warn "Branch $branch_name kept or already deleted."
        log_success "Cleaned up worktree and branch."
    fi
}

cmd_remove() {
    local task_name="${1:-}"
    local force=0
    if [ -z "$task_name" ]; then
        log_error "Task name required. Usage: agent-worktree remove <task-name> [--force]"
        exit 1
    fi

    if [ "${2:-}" = "--force" ] || [ "${2:-}" = "-f" ]; then
        force=1
    fi

    check_git_repo
    local repo_root
    repo_root="$(git rev-parse --show-toplevel)"
    local worktree_dir="${repo_root}/.worktrees/${task_name}"
    local branch_name="agent/${task_name}"

    if [ ! -d "$worktree_dir" ]; then
        log_warn "Worktree directory does not exist: $worktree_dir"
        git worktree prune
        exit 0
    fi

    log_info "Removing worktree at: $worktree_dir"
    if [ "$force" -eq 1 ]; then
        git worktree remove --force "$worktree_dir"
        git branch -D "$branch_name" 2>/dev/null || true
    else
        git worktree remove "$worktree_dir"
        git branch -d "$branch_name" 2>/dev/null || log_warn "Branch $branch_name not merged; delete with 'git branch -D $branch_name' if desired."
    fi
    log_success "Removed worktree: $task_name"
}

cmd_clean() {
    check_git_repo
    log_info "Pruning stale worktree metadata..."
    git worktree prune -v
    log_success "Prune complete."
}

action="${1:-}"
shift || true

case "$action" in
    new)    cmd_new "$@" ;;
    list|ls) cmd_list ;;
    merge)  cmd_merge "$@" ;;
    remove|rm) cmd_remove "$@" ;;
    clean)  cmd_clean ;;
    -h|--help) usage ;;
    *)
        usage
        exit 1
        ;;
esac
