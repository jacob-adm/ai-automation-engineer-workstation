#!/usr/bin/env bash
# bin/secret-run: Execute a command with scoped secrets without ambient environment leakage

set -euo pipefail

BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
CYAN="\033[0;36m"
RESET="\033[0m"

log_info()    { echo -e "${CYAN}[INFO]${RESET} $*" >&2; }
log_warn()    { echo -e "${YELLOW}[WARN]${RESET} $*" >&2; }
log_error()   { echo -e "${RED}[ERROR]${RESET} $*" >&2; }

usage() {
    cat << EOF
${BOLD}secret-run${RESET} - Run commands with scoped secrets without ambient shell leakage

${BOLD}Usage:${RESET}
  secret-run [--env-file <file>] -- <command> [args...]

${BOLD}Default Secret File Resolution:${RESET}
  1. File passed via --env-file
  2. .env.local in current directory
  3. .env in current directory
  4. ~/.secrets/ai.env
  5. ~/.dotfiles.local

${BOLD}Examples:${RESET}
  secret-run -- python eval_model.py --model gpt-4o
  secret-run --env-file ~/.keys/anthropic.env -- pytest tests/
EOF
}

ENV_FILE=""
COMMAND=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --env-file)
            ENV_FILE="$2"
            shift 2
            ;;
        --)
            shift
            COMMAND=("$@")
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            # If no '--' specified, treat everything starting from here as command
            COMMAND=("$@")
            break
            ;;
    esac
done

if [ ${#COMMAND[@]} -eq 0 ]; then
    log_error "No command specified."
    usage
    exit 1
fi

if [ -n "$ENV_FILE" ]; then
    if [ ! -f "$ENV_FILE" ]; then
        log_error "Specified secret file not found: '$ENV_FILE'"
        exit 1
    fi
else
    # Auto-locate default secret file if none was explicitly provided
    if [ -f ".env.local" ]; then
        ENV_FILE=".env.local"
    elif [ -f ".env" ]; then
        ENV_FILE=".env"
    elif [ -f "$HOME/.secrets/ai.env" ]; then
        ENV_FILE="$HOME/.secrets/ai.env"
    elif [ -f "$HOME/.dotfiles.local" ]; then
        ENV_FILE="$HOME/.dotfiles.local"
    fi
fi

if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
    # Security check: warn if world-readable
    perms=$(stat -c "%a" "$ENV_FILE" 2>/dev/null || stat -f "%Lp" "$ENV_FILE" 2>/dev/null || echo "")
    if [[ "$perms" =~ [4567]$ ]]; then
        log_warn "Secret file '$ENV_FILE' has loose permissions ($perms). Hardening to 600..."
        chmod 600 "$ENV_FILE" 2>/dev/null || true
    fi

    # Execute in subshell exporting loaded variables only for the command process
    (
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
        exec "${COMMAND[@]}"
    )
else
    # Run command directly if no secret file was found
    exec "${COMMAND[@]}"
fi
