#!/usr/bin/env bash
# ==============================================================================
# File:        bin/secret-run
# Component:   Credential Isolation Substrate
# Description: Ephemeral secret execution wrapper with subshell isolation.
# Invariants:  - Fail-closed on missing file, bad permissions (0600/0400), or non-owner UID.
#              - Never exports secrets into the parent process environment.
#              - Rejects code injection, subshells, backticks, and function syntax.
#              - Strips matching quotes and validates standard POSIX identifiers.
#              - Suppresses ambient ./.env when strict mode is active.
# Dependencies: bash (>= 4.0), stat, POSIX coreutils
# Target OS:   Ubuntu 22.04+ / Debian 12+ (or POSIX Bash 4.0+)
# ==============================================================================

set -euo pipefail

# ------------------------------------------------------------------------------
# Section 1: Terminal Styling & Logging Utilities
# ------------------------------------------------------------------------------
BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
CYAN="\033[0;36m"
RESET="\033[0m"

log_info()    { echo -e "${CYAN}[INFO]${RESET} $*" >&2; }
log_warn()    { echo -e "${YELLOW}[WARN]${RESET} $*" >&2; }
log_error()   { echo -e "${RED}[ERROR]${RESET} $*" >&2; }

# ------------------------------------------------------------------------------
# Section 2: Usage Documentation & Interface Definition
# ------------------------------------------------------------------------------
usage() {
    cat << EOF
${BOLD}secret-run${RESET} - Run commands with scoped secrets without ambient shell leakage

${BOLD}Usage:${RESET}
  secret-run [--env-file <file>] [--strict] -- <command> [args...]

${BOLD}Options:${RESET}
  --env-file <file>         Explicitly specify secret environment file to load
  --strict, --no-auto-env   Disable ambient .env / .env.local auto-discovery in current directory
                            (can also be enforced globally via SECRET_RUN_STRICT=1)
  -h, --help                Show this help message

${BOLD}Default Secret File Resolution:${RESET}
  1. File passed via --env-file
  2. .env.local in current directory (skipped if --strict or SECRET_RUN_STRICT=1)
  3. .env in current directory (skipped if --strict or SECRET_RUN_STRICT=1)
  4. ~/.secrets/ai.env
  5. ~/.dotfiles.local

${BOLD}Examples:${RESET}
  secret-run -- python eval_model.py --model gpt-4o
  secret-run --env-file ~/.keys/anthropic.env -- pytest tests/
  secret-run --strict -- ./run-agent-on-untrusted-repo.sh
EOF
}

# ------------------------------------------------------------------------------
# Section 3: CLI Argument & Option Parsing
# ------------------------------------------------------------------------------
ENV_FILE=""
COMMAND=()
# Allow environment override for strict mode default
STRICT_MODE="${SECRET_RUN_STRICT:-0}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --env-file)
            ENV_FILE="$2"
            shift 2
            ;;
        --strict|--no-auto-env)
            STRICT_MODE=1
            shift
            ;;
        --)
            # Double-dash designates end of options; remainder is the target command
            shift
            COMMAND=("$@")
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            # Support invocation without explicit double-dash delimiter
            COMMAND=("$@")
            break
            ;;
    esac
done

# Invariant: A target executable command must be specified
if [ ${#COMMAND[@]} -eq 0 ]; then
    log_error "No command specified."
    usage
    exit 1
fi

# ------------------------------------------------------------------------------
# Section 4: Secret File Discovery & Priority Resolution
# ------------------------------------------------------------------------------
if [ -n "$ENV_FILE" ]; then
    # When explicitly provided, fail immediately if target path does not exist
    if [ ! -f "$ENV_FILE" ]; then
        log_error "Specified secret file not found: '$ENV_FILE'"
        exit 1
    fi
else
    # Automatic discovery hierarchy:
    # 1. Local overrides (.env.local, .env) - suppressed in strict mode to protect against untrusted repos
    # 2. User vault (~/.secrets/ai.env)
    # 3. Machine-local dotfiles (~/.dotfiles.local)
    if [ "$STRICT_MODE" -eq 0 ] && [ -f ".env.local" ]; then
        ENV_FILE=".env.local"
    elif [ "$STRICT_MODE" -eq 0 ] && [ -f ".env" ]; then
        ENV_FILE=".env"
    elif [ -f "$HOME/.secrets/ai.env" ]; then
        ENV_FILE="$HOME/.secrets/ai.env"
    elif [ -f "$HOME/.dotfiles.local" ]; then
        ENV_FILE="$HOME/.dotfiles.local"
    fi
fi

# ------------------------------------------------------------------------------
# Section 5: Fail-Closed Security & Ownership Verification
# ------------------------------------------------------------------------------
if [ -n "$ENV_FILE" ] && [ -f "$ENV_FILE" ]; then
    # Permission invariant: Require strict 0600 (owner read/write) or 0400 (owner read-only)
    # Group or world readability constitutes an immediate token compromise risk on multi-user hosts
    perms=$(stat -c "%a" "$ENV_FILE" 2>/dev/null || stat -f "%OLp" "$ENV_FILE" 2>/dev/null || stat -f "%Lp" "$ENV_FILE" 2>/dev/null || echo "")
    if [[ ! "$perms" =~ ^0?[46]00$ ]]; then
        log_error "Secret file '$ENV_FILE' has insecure permissions ($perms). Refusing to execute."
        log_error "Permissions must be 0600 or 0400 (owner read/write only). Remediate with: chmod 600 '$ENV_FILE'"
        exit 1
    fi

    # Ownership invariant: Must be owned by current EUID to prevent privilege crossing
    owner_uid=$(stat -c "%u" "$ENV_FILE" 2>/dev/null || stat -f "%u" "$ENV_FILE" 2>/dev/null || echo "")
    if [ -n "$owner_uid" ] && [ "$owner_uid" -ne "$EUID" ]; then
        log_error "Secret file '$ENV_FILE' is owned by UID $owner_uid, not current user UID $EUID. Refusing to execute."
        exit 1
    fi

    # --------------------------------------------------------------------------
    # Section 6: Subshell Isolation & Safe AST Variable Parsing
    # --------------------------------------------------------------------------
    # Subshell boundary: Variables exported inside ( ... ) are reclaimed upon process exit.
    # The parent shell process remains completely clean with zero ambient credentials.
    (
        while IFS= read -r line || [ -n "$line" ]; do
            # Strip leading and trailing whitespace characters
            line="${line#"${line%%[![:space:]]*}"}"
            line="${line%"${line##*[![:space:]]}"}"

            # Ignore empty lines and comment markers
            [[ -z "$line" || "$line" =~ ^# ]] && continue

            # Security guard: Detect and reject shell expansion attacks
            # Prevents command injection payloads like $(rm -rf /) or `curl ...`
            if [[ "$line" =~ \$\( || "$line" =~ \` || "$line" =~ \;\; || "$line" =~ ^[[:space:]]*function[[:space:]] ]]; then
                log_error "Unsafe syntax detected in secret file '$ENV_FILE': $line"
                log_error "Lines must be standard KEY=VALUE assignments without subshells or command execution."
                exit 1
            fi

            # Normalize lines with optional 'export ' prefix
            if [[ "$line" =~ ^export[[:space:]]+(.*)$ ]]; then
                line="${BASH_REMATCH[1]}"
            fi

            # Validate standard POSIX identifier syntax: [A-Za-z_][A-Za-z0-9_]*
            if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
                key="${BASH_REMATCH[1]}"
                val="${BASH_REMATCH[2]}"

                # Validate and unwrap matching quote wrappers (double or single)
                if [[ "$val" =~ ^\"(.*)\"$ ]]; then
                    val="${BASH_REMATCH[1]}"
                elif [[ "$val" =~ ^\'(.*)\'$ ]]; then
                    val="${BASH_REMATCH[1]}"
                elif [[ "$val" =~ ^\" || "$val" =~ ^\' ]]; then
                    # Fail-closed on syntax error: Unclosed quotes indicate malformed credentials
                    log_error "Unclosed or mismatched quote detected in secret file '$ENV_FILE': $line"
                    exit 1
                fi

                # Export into subshell memory only
                export "$key=$val"
            else
                log_warn "Ignoring malformed line in '$ENV_FILE': $line"
            fi
        done < "$ENV_FILE"

        # Replace subshell image with target command
        exec "${COMMAND[@]}"
    )
else
    # Direct execution fallback when no secret file exists
    exec "${COMMAND[@]}"
fi
